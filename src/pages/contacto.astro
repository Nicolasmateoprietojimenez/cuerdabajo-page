---
import MainLayout from '../layouts/MainLayout.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<MainLayout
  title="Contrataciones — Cuerdabajo"
  description="Contrata a Cuerdabajo para tu festival, empresa, universidad, alcaldía o evento privado. Respuesta rápida por WhatsApp."
  darkHeader
>
  <div class="page-top">
    <Contacto />
  </div>
</MainLayout>

<style>
  .page-top :global(.contacto) {
    padding-top: clamp(6.5rem, 12vw, 9rem);
  }
</style>
