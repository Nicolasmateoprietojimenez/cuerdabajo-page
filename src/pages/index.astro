---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import Musica from '../components/sections/Musica.astro';
import Galeria from '../components/sections/Galeria.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<MainLayout
  title="Cuerdabajo — Música carranguera para tu evento | Soacha, Colombia"
  description="Contrata a Cuerdabajo, agrupación carranguera de Soacha. Carranga con actitud para festivales, empresas, universidades, alcaldías, matrimonios y eventos. ¡Escríbenos por WhatsApp!"
>
  <Hero />
  <About />
  <Nosotros compact />
  <Musica compact />
  <Galeria compact limit={6} />
  <Contacto />
</MainLayout>
