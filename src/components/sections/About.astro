---
/**
 * About / Nosotros — "Música que nos une".
 * Ícono + título en CuerdaFont + párrafo, centrado. Fluye sobre el mismo
 * fondo cálido del Hero.
 */
import { site } from '../../data/site';
---

<section class="about" aria-label="Cuerdabajo">
  <div class="about-inner">
    <span class="about-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="8" r="3.2" />
        <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
        <path d="M16 5.2a3 3 0 0 1 0 5.8" />
        <path d="M17.5 14.4A6.5 6.5 0 0 1 21.5 20" />
      </svg>
    </span>

    <h2 class="about-title">{site.tagline}</h2>

    <p class="about-text">
      Somos {site.name}: carranga de Soacha para el mundo. Canciones que cuentan de dónde
      venimos y para dónde vamos.
    </p>
  </div>
</section>

<style>
  .about {
    background-color: #e7dbcb;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  /* Solo mobile/tablet: en desktop no se muestra. */
  @media (min-width: 900px) {
    .about {
      display: none;
    }
  }
  .about-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 1.8vw, 1.5rem);
    text-align: center;
  }
  .about-icon {
    display: inline-flex;
    color: var(--color-primary);
  }
  .about-icon svg {
    width: 2.75rem;
    height: 2.75rem;
  }
  .about-title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 5.5vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  .about-text {
    margin: 1.25rem auto 0;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-foreground-muted);
  }
</style>
