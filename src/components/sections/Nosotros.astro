---
/**
 * Nosotros — presentación (fondo oscuro), con cifras destacadas.
 * prop `compact`: versión resumida para la home.
 * FOTO: public/images/nosotros.png (si no existe, placeholder con la ruta).
 */
import { stats } from '../../data/stats';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const instrumentos = ['Batería', 'Guitarra eléctrica', 'Sintetizadores', 'Tiple', 'Requinto', 'Guacharaca'];
---

<section id="nosotros" class="sec sec--dark nos">
  <div class="sec-inner">
    <div class="nos-top">
      <div class="nos-main" data-reveal>
        <span class="kicker">Nosotros</span>
        <h2 class="display display--lg nos-title">Somos <span class="text-primary">Cuerdabajo</span></h2>
        <p class="nos-lead">
          Somos ocho de Soacha y llevamos más de tres años en esto. Le metemos batería, guitarra
          eléctrica y sintes para que suene a hoy, sin soltar la raíz campesina — y donde caemos,
          <strong>se arma la farra</strong>.
        </p>

        {
          compact ? (
            <a class="nos-cta" href="/nosotros">
              Conócenos
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          ) : (
            <ul class="chips">
              {instrumentos.map((n) => (
                <li class="chip">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 18V5l10-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="16" cy="16" r="3" /></svg>
                  {n}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <figure class="nos-photo" data-reveal style="--reveal-delay:120ms">
        <img src="/images/nosotros.png" alt="La agrupación Cuerdabajo" loading="lazy" onerror="this.closest('.nos-photo').classList.add('is-empty'); this.remove();" />
        <figcaption class="ph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.6"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21" stroke-width="1.6"/></svg>
          <span>Agrega tu foto en<br /><code>public/images/nosotros.png</code></span>
        </figcaption>
      </figure>
    </div>

    {
      !compact && (
        <ul class="nos-stats" data-reveal data-nosstats>
          {stats.map((s) => (
            <li>
              <span class="ns-value" data-count={s.value} data-suffix={s.suffix ?? ''}>0</span>
              <span class="ns-label">{s.label}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

{
  !compact && (
    <script>
      const box = document.querySelector('[data-nosstats]');
      if (box) {
        const fmt = (n: number): string => n.toLocaleString('es-CO');
        const run = (el: HTMLElement): void => {
          const target = Number(el.dataset.count ?? '0');
          const suffix = el.dataset.suffix ?? '';
          const dur = 1400;
          const start = performance.now();
          const step = (now: number): void => {
            const p = Math.min((now - start) / dur, 1);
            el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - p, 3)))) + suffix;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                box.querySelectorAll<HTMLElement>('.ns-value').forEach(run);
                io.disconnect();
              }
            });
          },
          { threshold: 0.3 },
        );
        io.observe(box);
      }
    </script>
  )
}

<style>
  .nos-top { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  .nos-title { margin: 0.25rem 0 1.25rem; color: #fff; }
  .nos-lead { margin: 0; max-width: 40rem; font-size: clamp(1.1rem, 2.3vw, 1.4rem); line-height: 1.55; color: #f0e6d6; }
  .nos-lead strong { color: var(--color-primary); }

  .nos-cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: var(--text-small); color: #fff; text-decoration: none; }
  .nos-cta svg { width: 1.15rem; height: 1.15rem; color: var(--color-primary); transition: transform var(--transition-fast) var(--ease-brand); }
  .nos-cta:hover svg { transform: translateX(4px); }

  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.45rem 0.9rem; border: 1px solid rgba(240,230,214,.2); border-radius: var(--radius-full); font-size: var(--text-small); font-weight: 600; color: #f0e6d6; }
  .chip svg { width: 0.95rem; height: 0.95rem; color: var(--color-primary); }

  /* Foto / placeholder */
  .nos-photo { position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; background: #241f1a; }
  .nos-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ph { display: none; position: absolute; inset: 0; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; text-align: center; padding: 1.5rem; color: #8a8073; border: 2px dashed rgba(240,230,214,.18); border-radius: var(--radius-lg); }
  .nos-photo.is-empty .ph { display: flex; }
  .ph svg { width: 2.5rem; height: 2.5rem; color: var(--color-primary); }
  .ph code { color: #f0e6d6; font-size: 0.9em; }

  /* Cifras (oscuro, fuente clara) */
  .nos-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding-block: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid rgba(240, 230, 214, 0.12);
    border-bottom: 1px solid rgba(240, 230, 214, 0.12);
    list-style: none;
  }
  .nos-stats li { text-align: center; }
  .ns-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }
  .ns-label {
    display: block;
    margin-top: 0.45rem;
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.35;
    color: #c7bba7;
  }

  @media (min-width: 900px) {
    .nos-top { grid-template-columns: 1.4fr 1fr; }
    .nos-stats { grid-template-columns: repeat(4, 1fr); }
  }
</style>
